# Local-first configuration: no API keys are needed.
PORT=8000
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
SDXL_MODEL=stabilityai/sdxl-turbo
SDXL_STEPS=4
PIPER_EXECUTABLE=
PIPER_MODEL_EN_FEMALE=./models/voices/en_US-amy-medium.onnx
PIPER_MODEL_EN_MALE=./models/voices/en_US-joe-medium.onnx
PIPER_MODEL_HI_FEMALE=./models/voices/hi_IN-priyamvada-medium.onnx
PIPER_MODEL_HI_MALE=./models/voices/hi_IN-rohan-medium.onnx
WHISPER_MODEL=small
OUTPUT_DIR=./outputs
JOBS_DIR=./jobs
CACHE_DIR=./cache
MUSIC_DIR=./assets/music
SFX_DIR=./assets/sfx
FONT_PATH=./assets/fonts/DejaVuSans-Bold.ttf

# Optional cloud providers are deliberately unused by the local-only pipeline.
# Keys may be configured for future explicit fallback support; they are never logged.